# Google Gemini API key (Server-side only)
# Get a free API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Session signing secret (Server-side only)
# Used to sign the login session cookie so sessions survive reloads &
# cold starts and cannot be tampered with. Use a long random string in
# production, e.g. `openssl rand -hex 32`. Falls back to an insecure default
# for local development if not set.
SESSION_SECRET=
