# Google Gemini API key (Server-side only)
# Get a free API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Session signing secret (Server-side only)
# Used to sign the login session cookie so sessions survive reloads &
# cold starts and cannot be tampered with. Use a long random string in
# production, e.g. `openssl rand -hex 32`. Falls back to an insecure default
# for local development if not set.
SESSION_SECRET=

# --- Site owner admin account (Server-side only) ---
# The /admin dashboard account is seeded from these. There is NO default and
# NO hardcoded fallback: if they are missing, no admin is created and the
# dashboard is unreachable until you configure them. That is intentional —
# this repo is public, so an in-source credential would be a published one.
#
# ADMIN_PASSWORD_HASH must be a `scrypt$<salt>$<hash>` value, never a plaintext
# password. Generate a strong random password + its hash with:
#     node scripts/admin-credentials.mjs generate
# Then create/rotate the live account (this is the ONLY way an existing
# password changes — a redeploy never resets it):
#     DATABASE_URL=<neon url> node scripts/admin-credentials.mjs apply
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional: override the owner's user id (defaults to "admin-user-id").
ADMIN_ID=
