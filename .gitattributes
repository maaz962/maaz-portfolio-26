# Treat everything as text (UTF-8, LF), avoid editors silently saving cp1252/CRLF
* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.gitignore text eol=lf
*.editorconfig text eol=lf